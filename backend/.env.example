# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below has a working default in
# app/core/config.py, so the backend runs even with an empty .env.
# ---------------------------------------------------------------------------

ENV=development

# --- Database -------------------------------------------------------------
# PostgreSQL (the intended production database):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/qrwatermark
# SQLite fallback for a zero-setup local run:
# DATABASE_URL=sqlite:///./storage/docauth.db

# --- Signing --------------------------------------------------------------
# ES256 (ECDSA P-256) keeps the QR payload sparse enough to scan with a phone.
# RSA-PSS-SHA256 is also supported, at the cost of a much denser QR code.
SIGN_ALGORITHM=ES256
RSA_KEY_SIZE=2048

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_MB=25

# --- Fragmentation --------------------------------------------------------
# Grid resolution per page. More cells = finer tamper localisation, more hashes.
FRAGMENT_ROWS=6
FRAGMENT_COLS=2
# Height in PDF points of the footer band reserved for the QR + watermark
# stamp. This band is excluded from fragmentation.
FOOTER_BAND_PT=74
# Render resolution used for the per-fragment raster hash.
RASTER_DPI=100
ENABLE_RASTER_HASH=true

# --- Watermarking ---------------------------------------------------------
DWT_WAVELET=haar
DWT_ALPHA=12
DWT_BITS=128

# --- Email (optional; verification reports) -------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@docauth.dev
SMTP_TLS=true
